---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Lid from '../components/Lid.astro';
import Scene from '../components/Scene.astro';
import Split from '../components/Split.astro';
import Chrome from '../components/Chrome.astro';
import Footer from '../components/Footer.astro';
import { products } from '../data/products';

const moments = [
  { word: 'HYDRATE', scene: 'hydrate', note: 'the glass-of-water moment your skin keeps asking for.', p: 0 },
  { word: 'SOOTHE', scene: 'soothe', note: 'for red, tight, windy-day, too-much-retinol days.', p: 3 },
  { word: 'PROTECT', scene: 'protect', note: 'sun, smog, office aircon — we hold the line.', p: 1 },
];
---
<Base>
  <div class="preloader" aria-hidden="true"><Logo /></div>

  <Chrome />

  <canvas class="jar-canvas" aria-hidden="true"></canvas>

  <main id="main">
    <!-- ================= HERO ================= -->
    <section class="hero paper" id="about">
      <div class="hero__top">
        <p class="hero__kicker"><span>WE'RE</span><Logo /><span>HERE TO</span></p>
        <h1 class="hero__title">
          <span class="line"><Split text="GLOW" /></span>
          <span class="line"><Split text="WITH YOU" /></span>
        </h1>
      </div>

      <div class="hero__dome paper" data-theme="dark">
        <svg class="trail" aria-hidden="true">
          <defs>
            <linearGradient id="cream-grad" x1="0" x2="1">
              <stop offset="0" stop-color="#f3dcc6" /><stop offset=".35" stop-color="#fffaf2" /><stop offset=".7" stop-color="#fff4e6" /><stop offset="1" stop-color="#e9cdb3" />
            </linearGradient>
          </defs>
          <path class="trail__path" d="" fill="none" stroke="url(#cream-grad)" stroke-linecap="round" />
          <path class="trail__shine" d="" fill="none" stroke="#fff" stroke-opacity=".7" stroke-linecap="round" />
        </svg>

        <div class="collage">
          <div class="todo" data-speed="-0.12">
            <span class="washi washi--butter" style="top:-16px;left:50%;translate:-50% 0;rotate:3deg;width:90px"></span>
            <h3>SKIN TO-DO</h3>
            <ul class="hand">
              <li class="done">double cleanse</li>
              <li>SPF before school run</li>
              <li>drink. more. water.</li>
              <li>moisturise (for real)</li>
            </ul>
          </div>
          <svg class="clip" data-speed="-0.12" viewBox="0 0 40 90" aria-hidden="true"><path d="M12 80V20a8 8 0 0 1 16 0v52a12 12 0 0 1-24 0V14a14 14 0 0 1 28 0v56" fill="none" stroke="#c9c9d1" stroke-width="4" stroke-linecap="round"/></svg>

          <p class="note hand" data-speed="0.08">made for everyday skin.<br />not a lab — just real life.
            <svg viewBox="0 0 80 20" aria-hidden="true"><path d="M2 12 C 20 2, 40 20, 78 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
          </p>

          <div class="pattern" data-speed="0.18">
            <span class="washi washi--pink" style="top:6px;right:-24px;rotate:38deg"></span>
            <svg viewBox="0 0 400 350" aria-hidden="true">
              <defs>
                <pattern id="peach" width="100" height="100" patternUnits="userSpaceOnUse" patternTransform="rotate(-10)">
                  <rect width="100" height="100" fill="#ffe3ec" />
                  <circle cx="30" cy="34" r="20" fill="#ff9a7a" /><circle cx="24" cy="28" r="6" fill="#ffc3ad" />
                  <path d="M30 14 q8 -10 18 -6 q-6 10 -18 6z" fill="#1f9d63" />
                  <circle cx="80" cy="80" r="14" fill="#ffd84d" /><path d="M80 66 q6 -8 14 -4 q-4 8 -14 4z" fill="#1f9d63" />
                  <path d="M70 26 l3 6 6 1 -5 4 1 6 -5 -3 -5 3 1 -6 -5 -4 6 -1z" fill="#ff5c8a" />
                </pattern>
              </defs>
              <rect width="400" height="350" fill="url(#peach)" />
            </svg>
          </div>

          <div class="kraft" data-speed="-0.05">
            <span class="washi"></span>
            <p class="kraft__text"><Split text="DRY PATCHES, LATE NIGHTS, CITY SMOG, SURPRISE BREAKOUTS. WE ALWAYS GLOW WITH YOU." /></p>
          </div>

          <svg class="gift" data-speed="0.22" viewBox="0 0 300 260" aria-hidden="true">
            <rect x="20" y="70" width="260" height="180" rx="8" fill="#ff5c8a" />
            <g clip-path="url(#giftclip)"><clipPath id="giftclip"><rect x="20" y="70" width="260" height="180" rx="8" /></clipPath>
              {Array.from({ length: 14 }).map((_, i) => <rect x={20 + i * 22} y="70" width="10" height="180" fill="#ffb3cf" />)}
            </g>
            <rect x="10" y="56" width="280" height="40" rx="8" fill="#ff7a3d" />
            <rect x="136" y="56" width="28" height="194" fill="#fff4e6" />
            <rect x="10" y="66" width="280" height="18" fill="#fff4e6" opacity=".9" />
            <path d="M150 58 C110 0 60 20 90 50 C105 64 140 60 150 58z M150 58 C190 0 240 20 210 50 C195 64 160 60 150 58z" fill="#fff4e6" stroke="#e9cdb3" stroke-width="3" />
          </svg>
        </div>
      </div>
    </section>

    <!-- ================= WAVE BAND ================= -->
    <section class="band" aria-label="When skin gets moody, something has to care">
      <svg viewBox="0 0 1600 300" preserveAspectRatio="none" aria-hidden="true">
        <path id="wave" d="M-200 190 C 100 60, 300 60, 600 150 S 1100 260, 1400 140 S 1800 60, 2000 130" fill="none" stroke="#ffd84d" stroke-width="130" stroke-linecap="butt" />
        <text dy="20"><textPath class="band__text" href="#wave" startOffset="0">WHEN SKIN GETS MOODY, ✿ SOMETHING HAS TO CARE ✿ WHEN SKIN GETS MOODY, ✿ SOMETHING HAS TO CARE ✿ WHEN SKIN GETS MOODY, ✿ SOMETHING HAS TO CARE ✿ WHEN SKIN GETS MOODY, ✿ SOMETHING HAS TO CARE ✿</textPath></text>
      </svg>
    </section>

    <!-- ================= PRODUCT FAMILY ================= -->
    <section class="fam paper" id="family" aria-roledescription="carousel" aria-label="The Ascel Beauty family">
      <span class="fam__label">MEET THE ONE WHO CARES</span>
      <div class="fam__stage">
        {products.map((p, i) => (
          <>
            <h2 class="fam__the" data-slide={i} hidden={i !== 0}><Split text="THE" /></h2>
            <p class="fam__nick" data-slide={i} hidden={i !== 0}><Split text={p.nick} /></p>
          </>
        ))}
        <div class="fam__card-wrap">
          {products.map((p, i) => (
            <div class="fam__cards" data-slide={i} hidden={i !== 0}>
              <div class="fam__card fam__card--l"><Scene kind={p.scenes[0]} lid={p.lid} ink={p.ink} /></div>
              <div class="fam__card fam__card--r"><Scene kind={p.scenes[1]} lid={p.lid} ink={p.ink} /></div>
            </div>
          ))}
        </div>
        <div class="fam__lid" data-cursor="OPEN" role="link" tabindex="0" aria-label="Open product page">
          {products.map((p, i) => <Lid p={p} uid={`fam-${i}`} class={i === 0 ? 'is-active' : ''} />)}
        </div>
        <a class="explore" href={`/products/${products[0].id}`} data-cursor="VIEW">
          <svg class="ring" viewBox="0 0 100 100" aria-hidden="true"><defs><path id="exp-ring" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" /></defs><text><textPath href="#exp-ring">EXPLORE • EXPLORE • EXPLORE •</textPath></text></svg>
          <b aria-hidden="true">↗</b><span class="sr-only">Explore product</span>
        </a>
        <div class="fam__info">
          {products.map((p, i) => (
            <div data-slide={i} hidden={i !== 0}>
              <ul class="fam__tags">{p.tags.map((t) => <li>{t}</li>)}</ul>
              <p class="fam__blurb">{p.blurb}</p>
            </div>
          ))}
        </div>
        <div class="fam__rail" role="tablist" aria-label="Choose a cream">
          {products.map((p, i) => (
            <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} class={i === 0 ? 'is-active' : ''} data-go={i} aria-label={`${p.name} ${p.name2}`} data-cursor="PICK">
              <Lid p={p} uid={`rail-${i}`} />
            </button>
          ))}
        </div>
      </div>
      <p class="fam__count"><span class="fam__cur">01</span> / {String(products.length).padStart(2, '0')}</p>
      <div class="fam__arrows"><button class="fam__prev" aria-label="Previous cream">←</button><button class="fam__next" aria-label="Next cream">→</button></div>
      <script type="application/json" id="products-data" set:html={JSON.stringify(products)} />
    </section>

    <!-- ================= MOMENTS ================= -->
    <section class="moments paper" id="moments">
      <h2 class="moments__head"><Split text="WE'RE HERE" /><br /><Split text="FOR THE EVERYDAY" /><br /><Split text="MOMENTS." /></h2>
      <div class="moments__pin">
        <div class="moments__track">
          {moments.map((m, i) => (
            <div class="mo">
              <span class="mo__num" aria-hidden="true">{i + 1}</span>
              <span class="mo__word">TO</span>
              <div class="mo__card"><Scene kind={m.scene} lid={products[m.p].lid} ink={products[m.p].ink} /></div>
              <span class="mo__word">{m.word}</span>
              <p class="mo__note hand">{m.note}</p>
              <div class="mo__lid" data-px={i % 2 ? '-0.35' : '0.3'} style={`left:${i % 2 ? '72%' : '-6%'};top:${i % 2 ? '58%' : '-4%'}`}><Lid p={products[(m.p + 2) % products.length]} uid={`mo-${i}`} /></div>
              <div class="mo__lid" data-px={i % 2 ? '0.25' : '-0.2'} style={`left:${i % 2 ? '18%' : '84%'};top:${i % 2 ? '-8%' : '64%'}`}><Lid p={products[(m.p + 4) % products.length]} uid={`mo2-${i}`} /></div>
              {i === 0 && <svg class="mo__doodle" style="left:-12%;top:16%" viewBox="0 0 200 120" aria-hidden="true"><path d="M6 20 C 60 0, 120 30, 170 100" fill="none" stroke="currentColor" stroke-width="2.5" /><path d="M150 96 l22 6 -2 -22" fill="none" stroke="currentColor" stroke-width="2.5" /></svg>}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= CTA ================= -->
    <section class="cta paper" id="shop">
      <div class="cta__grid">
        <div class="cta__pile" aria-hidden="true">
          {products.map((p, i) => {
            const pos = [[4, 52, -14], [30, 30, 8], [54, 50, -4], [12, 8, 12], [52, 4, -10], [34, 68, 16]][i];
            return <div class="cta__pile-item" data-i={i} style={`position:absolute;left:${pos[0]}%;top:${pos[1]}%;width:44%;rotate:${pos[2]}deg`}><Lid p={p} uid={`cta-${i}`} /></div>;
          })}
        </div>
        <div class="cta__panel">
          <h2><Split text="LET'S" /><br /><Split text="MAKE IT" /><br /><Split text="GLOW!" /></h2>
          <p>For every skin that matters. Six everyday creams, one soft promise.</p>
          <a class="btn" href="#family" data-cursor="GO">SHOP THE FAMILY →</a>
        </div>
      </div>
      <div class="cta__dome"></div>
    </section>

    <!-- ================= FOOTER ================= -->
    <Footer />
  </main>

  <script>
    import { init } from '../scripts/main';
    init();
  </script>
</Base>
