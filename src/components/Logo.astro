---
interface Props { class?: string; fill?: string; ink?: string; }
const { class: cls = '', fill = '#5A0F2E', ink = '#FFF4E6' } = Astro.props;
---
<svg class={`logo ${cls}`} viewBox="0 0 220 150" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Ascel Beauty">
  <!-- cream dollop badge -->
  <path fill={fill} d="M110 6c14 0 22 9 20 20 18-6 36 4 36 20 22-2 44 12 44 36 0 22-16 34-34 36 4 22-14 34-36 30-10 12-48 12-60 0-22 4-40-8-36-30C26 116 10 104 10 82c0-24 22-38 44-36 0-16 18-26 36-20-2-11 6-20 20-20z"/>
  <path fill="none" stroke={ink} stroke-width="4" stroke-linecap="round" d="M104 18c6-4 14 0 12 7" opacity=".7"/>
  <text x="110" y="78" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="900" font-size="44" fill={ink} letter-spacing="1">ASCEL</text>
  <text x="110" y="114" text-anchor="middle" font-family="Barlow Condensed, sans-serif" font-weight="900" font-size="32" fill={ink} letter-spacing="2">BEAUTY</text>
  <text x="196" y="20" font-family="Inter Tight, sans-serif" font-weight="700" font-size="11" fill={fill}>™</text>
</svg>
